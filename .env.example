# Copy to .env and fill in. Required — src/utils.js reads this at build time and
# Firebase will fail to initialize if it is missing.
#
# NOTE: this is NOT a secret. Vite inlines every VITE_* value into the built JS
# bundle, so this key is served to every visitor no matter what. Firebase web
# API keys are public project identifiers by design; they are not credentials.
# What actually protects the data is:
#   1. firestore.rules  (per-user access control)
#   2. Firebase Console > Authentication > Settings > Authorized domains
#   3. Google Cloud Console > Credentials > API key > Application restrictions
VITE_FIREBASE_API_KEY=


# Optional, but it is what makes awkward streams playable. Deploy the worker in
# proxy/ and put its URL here, WITH a trailing slash — the value is prefixed
# directly onto the target URL.
#
#   VITE_CORS_PROXY=https://m3tv-proxy.<subdomain>.workers.dev/
#
# Streams and playlists are always tried directly first and most never touch
# it. Two cases do need it:
#
#   1. the stream server sends no Access-Control-Allow-Origin — hls.js fetches
#      the manifest and every segment over XHR, so Chrome and Firefox refuse
#      them. Retried through the proxy after the direct attempt fails.
#   2. an http:// stream on the https:// site — blocked as mixed content before
#      the request is even made. Nothing to learn from trying, so these go
#      straight through the proxy.
#
# Safari and iOS play HLS natively, which CORS does not apply to, so they only
# need this for case 2.
#
# Left empty, both cases simply fail and the user is told the stream refuses
# playback. See proxy/README.md.
VITE_CORS_PROXY=
