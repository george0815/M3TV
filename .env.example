# Copy to .env and fill in. Required — src/utils.js reads this at build time and
# Firebase will fail to initialize if it is missing.
#
# NOTE: this is NOT a secret. Vite inlines every VITE_* value into the built JS
# bundle, so this key is served to every visitor no matter what. Firebase web
# API keys are public project identifiers by design; they are not credentials.
# What actually protects the data is:
#   1. firestore.rules  (per-user access control)
#   2. Firebase Console > Authentication > Settings > Authorized domains
#   3. Google Cloud Console > Credentials > API key > Application restrictions
VITE_FIREBASE_API_KEY=


# Optional. Leave empty unless you are running a CORS proxy.
#
# Streams and playlists are always tried directly first, and anything whose
# server sends Access-Control-Allow-Origin plays without this. Safari and iOS
# play HLS through the browser's own media pipeline, which CORS does not apply
# to, so they never need it either.
#
# It only matters for a stream whose server sends no CORS headers, played in a
# browser without native HLS (Chrome, Firefox). hls.js fetches the manifest and
# every segment over XHR, so the browser blocks those outright and no amount of
# client-side code can change that. With this set, such a stream is retried
# through the proxy; without it, the user is told the stream refuses playback.
#
# The value is prefixed to the target URL, so it needs a trailing slash or a
# trailing "?url=" depending on what your proxy expects. Be aware that routing
# live video through a proxy puts all of that bandwidth on your own infra.
VITE_CORS_PROXY=
